{
  "expo": {
    "name": "FitJourney",
    "slug": "losing-weight-tracker",
    "scheme": "weighttracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harrytrinh.losingweighttracker"
    },
    "android": {
      "package": "com.harrytrinh.losingweighttracker",
      "adaptiveIcon": {
        "backgroundColor": "#110D22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110D22",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#110D22",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép truy cập thư viện ảnh để đính kèm ảnh minh chứng hoàn thành bữa ăn/buổi tập.",
          "cameraPermission": "Cho phép dùng camera để chụp ảnh minh chứng hoàn thành bữa ăn/buổi tập."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F8EF7"
        }
      ],
      "expo-secure-store"
    ]
  }
}
